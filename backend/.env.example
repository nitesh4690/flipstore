# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection (Docker/local). For quick local dev without Postgres you can use:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flipystore

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://flipstore-one.vercel.app

# Payments (Phase 7) — mock gateway works with no keys; Stripe driver later
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# Email (Phase 7) — "" auto-selects: memory in tests, file in development.
# Set EMAIL_BACKEND=smtp (and the SMTP_* values) for real delivery.
EMAIL_BACKEND=
EMAIL_FROM="FlipStore <no-reply@flipstore.example>"
EMAIL_FILE_PATH=emails.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Links inside emails
FRONTEND_URL=http://localhost:5173

ENVIRONMENT=development
